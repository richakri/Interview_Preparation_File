# Pipeline Simple 
# ============
pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/example/application.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Deploy') {
            steps {
                sh 'kubectl apply -f deployment.yaml'
            }
        }
    }
}
#===============
#============
pipeline {
	agent any 

	stages {
			stage (‘checkout’) {

				steps{

					git ‘git url’
				}
			}
			stage (‘build’) {

				steps{

					sh ‘mvn clean package’
				}
			}
			stage (‘security scan’) {

				steps {

					sh ‘sonar - scanner’
				}
			}
			stage (‘test’) {

				step {

					sh ‘mvn test’
				}
			}
			stage (‘deployment’) {

				step {

					sh ‘kubectl apply -f deployment.yaml’
				}
			}
			
	}

}	

# Pipeline → agent → stages → stage → steps → command 
